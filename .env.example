# ============================================================
# Wings 3.1 — 梨江中学德育管理平台 SaaS 版
# 环境变量配置模板 (.env.example)
#
# 使用方式:
#   1. 复制此文件为 .env:  cp .env.example .env
#   2. 将下方所有 PLACEHOLDER 替换为真实凭证
#   3. 切勿将 .env 提交到 Git (已在 .gitignore 中排除)
# ============================================================

# ── 部署模式 ──
ENV=development          # development | staging | production
DEBUG=true               # 生产环境务必设为 false

# ── JWT 鉴权密钥 (必须修改!) ──
SECRET_KEY=PLACEHOLDER_SECRET_KEY_CHANGE_ME_MIN_32_CHARS
JWT_SECRET_KEY=PLACEHOLDER_JWT_SECRET_KEY_CHANGE_ME_MIN_32_CHARS

# ── 数据库 (必须修改!) ──
# 异步引擎使用 aiomysql；同步脚本使用 pymysql
DATABASE_URL=mysql+aiomysql://USERNAME:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL_SYNC=mysql+pymysql://USERNAME:PASSWORD@HOST:PORT/DB_NAME

# ── Redis / Celery 异步引擎 (必须修改!) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=PLACEHOLDER_REDIS_PASSWORD_CHANGE_ME
REDIS_EVENT_DB=1                      # 事件总线专用 DB
CELERY_BROKER_URL=redis://:PLACEHOLDER_REDIS_PASSWORD_CHANGE_ME@127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://:PLACEHOLDER_REDIS_PASSWORD_CHANGE_ME@127.0.0.1:6379/3

# ── DeepSeek LLM API (必须修改!) ──
LLM_API_KEY=PLACEHOLDER_DEEPSEEK_API_KEY_CHANGE_ME
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat

# ── 内部 API / Webhook 密钥 (必须修改!) ──
INTERNAL_API_KEY=PLACEHOLDER_INTERNAL_API_KEY_CHANGE_ME_64_HEX
WEBHOOK_SECRET=PLACEHOLDER_WEBHOOK_SECRET_CHANGE_ME_64_HEX

# ── 加密密钥 (Fernet, 必须修改!) ──
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PSY_ENCRYPTION_KEY=PLACEHOLDER_FERNET_KEY_CHANGE_ME_BASE64
WINGS_ENCRYPTION_KEY=PLACEHOLDER_FERNET_KEY_CHANGE_ME_BASE64

# ── 租户哨兵模式 ──
TENANT_SENTINEL_MODE=error            # error | warn | silent

# ── 报告输出目录 ──
REPORTS_OUTPUT_DIR=/var/www/wings3-static/exports/reports
